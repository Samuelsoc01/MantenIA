# MantenIA MVP v1.0 (rama mvp-v1.0). Separada de la v0.2 por la decisión D16.
# Puertos del host (solo 127.0.0.1). La v0.2 usa el 8000; la v1.0 usa 8100 (backend) y 8101 (Edge en modo local).
MANTENIA_BACKEND_PORT=8100
MANTENIA_EDGE_PORT=8101
# Volumen Docker propio de la v1.0 (no reutilizar mantenia-v02_mantenia_db).
MANTENIA_V10_VOLUME=mantenia-v10_mantenia_db
APP_ENV=development
DATABASE_URL=sqlite:///database/mantenia_v10.db
EDGE_SERVICE_URL=http://127.0.0.1:8101
STORE_RAW_INPUTS=false
ESTIMATED_COST_PER_INFERENCE_MXN=0.7333
BILLING_FIXED_FEE_MXN=3500.00
BILLING_RATE_PER_UNIT_MXN=1.00
PROJECT_NAME=MantenIA
COMPONENT_NAME=backend
RESOURCE_NAME=cpu
DEFAULT_CLIENT_ID=cliente_demo_01
MAX_CSV_ROWS=1000
MAX_REQUEST_BYTES=2097152
RETENTION_DAYS=30
EDGE_TIMEOUT_SECONDS=30
# Fase 1 — Autenticación (sin secretos: las cuentas se crean con python -m backend.app.manage)
# APP_ENV admite development | test | staging | production.
# En staging/producción SESSION_COOKIE_SECURE debe ser true; con false el backend no arranca.
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
API_KEY_DEFAULT_DAYS=90
API_KEY_MAX_DAYS=365
# Bloque B — alertas, deriva y FinOps simulado (valores por omisión; sin secretos)
ALERT_MIN_REQUESTS=20
ALERT_ERROR_RATE=0.05
ALERT_P95_MS=2000
ALERT_WINDOW_HOURS=24
DRIFT_WINDOW_DAYS=7
DRIFT_MIN_SAMPLE=200
BUDGET_MONTHLY_MXN=2200
BUDGET_ALERT_RATIO=0.80
# Tarifas de referencia SIMULADAS (2026-11-25): derivadas del OPEX de 2,200 MXN/mes ~ VM 2 vCPU/4 GiB/50 GB, 730 h, reparto 60/30/10 %
FINOPS_RATE_VCPU_HOUR_MXN=0.9041
FINOPS_RATE_GB_RAM_HOUR_MXN=0.2260
FINOPS_RATE_GB_STORAGE_MONTH_MXN=4.40
FINOPS_RATES_DATE=2026-11-25
FINOPS_SAMPLE_SECONDS=60
